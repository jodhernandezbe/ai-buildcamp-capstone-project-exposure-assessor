# Copy this file to .env and fill in your API key.
# .env is gitignored so your keys stay out of the repo.

OPENAI_API_KEY=your-openai-key-here

# EPA CompTox Chemicals Dashboard API key (request one from the CTX API team).
COMPTOX_API_KEY=your-comptox-api-key-here

# U.S. Census Bureau API key, free: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=your-census-key-here
