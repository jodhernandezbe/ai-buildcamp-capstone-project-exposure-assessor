{
  "name": "exposure-assessor-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "gen:types": "node scripts/contract.mjs",
    "check:contract": "node scripts/contract.mjs --check",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run check:contract && npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "lucide-react": "1.60.0",
    "maplibre-gl": "6.15.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
