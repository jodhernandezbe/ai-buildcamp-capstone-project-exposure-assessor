.env
.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.DS_Store

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Packaging
*.egg-info/
build/
dist/

# Editors
.idea/
.vscode/

# Local caches (e.g. the persisted SCC vector index)
.cache/

# Generated agent-evaluation reports (cassettes in evals/cassettes/ are committed)
evals/reports/

# Frontend toolchain and build output (the backend serves frontend/dist/)
node_modules/
frontend/dist/

# Raw downloads: only the compact derived files in data/ are committed
data/raw/
frontend/*.tsbuildinfo
# npm is the package manager (package-lock.json); a yarn lockfile would pin other versions.
frontend/yarn.lock

# Logfire project credentials written by `logfire projects use`
.logfire/
